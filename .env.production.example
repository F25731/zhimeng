APP_ENV=production
APP_PORT=8080
PUBLIC_BASE_URL=https://control.example.com
ROOT_DOMAIN=example.com
ADMIN_PATH=/zhimeng

POSTGRES_DB=control_center
POSTGRES_USER=control
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://control:CHANGE_TO_LONG_RANDOM_PASSWORD@control-postgres:5432/control_center?sslmode=disable
POSTGRES_ADMIN_URL=postgres://control:CHANGE_TO_LONG_RANDOM_PASSWORD@control-postgres:5432/postgres?sslmode=disable

SESSION_SECRET=CHANGE_TO_64_RANDOM_CHARACTERS
CSRF_SECRET=CHANGE_TO_64_RANDOM_CHARACTERS
CARD_HASH_SECRET=CHANGE_TO_64_RANDOM_CHARACTERS
MASTER_ENCRYPTION_KEY=CHANGE_TO_64_RANDOM_CHARACTERS

DOCKER_NETWORK=platform-proxy
DATABASE_NETWORK=zhimeng-control-private
SITE_BASE_DIR=/opt/platform/sites
SITE_TEMPLATE_DIR=/app/templates
SITE_IMAGE_DEFAULT=ghcr.io/example/site-app:latest
REPORTER_IMAGE=zhimeng-control-backend:local
SITE_ROUTER_PORT=19541
SITE_ROUTER_URL=http://site-router
VERIFY_PUBLIC_HTTPS=true
ROUTE_PROBE_TIMEOUT_SECONDS=90
WORKER_READY_TIMEOUT_SECONDS=180

AGENT_ID=node-001
AGENT_POLL_INTERVAL_SECONDS=3
AGENT_LEASE_SECONDS=30
SSE_HEARTBEAT_SECONDS=15
SITE_WARNING_SECONDS=60
SITE_OFFLINE_SECONDS=120

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=
