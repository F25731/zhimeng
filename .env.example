APP_ENV=development
APP_PORT=8080
PUBLIC_BASE_URL=https://control.example.com
ROOT_DOMAIN=example.com
ADMIN_PATH=/zhimeng

DATABASE_URL=postgres://control:control_password@127.0.0.1:5433/control_center?sslmode=disable

SESSION_SECRET=replace_me
CSRF_SECRET=replace_me
CARD_HASH_SECRET=replace_me
MASTER_ENCRYPTION_KEY=replace_me

POSTGRES_ADMIN_URL=postgres://control:control_password@127.0.0.1:5433/postgres?sslmode=disable

DOCKER_NETWORK=platform-proxy
DATABASE_NETWORK=zhimeng-control-private
SITE_BASE_DIR=/opt/platform/sites
SITE_IMAGE_DEFAULT=ghcr.io/example/site-app:latest
REPORTER_IMAGE=zhimeng-control-backend:local
SITE_TEMPLATE_DIR=../deploy/templates
SITE_ROUTER_URL=http://site-router
VERIFY_PUBLIC_HTTPS=false
ROUTE_PROBE_TIMEOUT_SECONDS=30
WORKER_READY_TIMEOUT_SECONDS=120

AGENT_ID=node-001
AGENT_POLL_INTERVAL_SECONDS=3
AGENT_LEASE_SECONDS=30

SSE_HEARTBEAT_SECONDS=15
SITE_WARNING_SECONDS=60
SITE_OFFLINE_SECONDS=120

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=
